{
  "name": "job-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed Job Scheduling Platform — PostgreSQL-backed job queue with atomic claiming, retries, DLQ, cron scheduling, workers, and a real-time dashboard.",
  "scripts": {
    "dev": "pnpm --filter @js/api dev & pnpm --filter @js/worker dev",
    "dev:api": "pnpm --filter @js/api dev",
    "dev:worker": "pnpm --filter @js/worker dev",
    "dev:web": "pnpm --filter @js/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @js/api test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @js/api db:migrate",
    "db:generate": "pnpm --filter @js/api db:generate",
    "db:seed": "pnpm --filter @js/api db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prisma": "^6.12.0"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1"
  }
}
