# ══════════════════════════════════════════════════════════════════════════════
#  JobScheduler — environment configuration
#  Copy to `.env` (repo root). apps/api and apps/worker both load the root .env;
#  a per-app .env in apps/<app>/ takes precedence if present.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (API + worker).
# REQUIRED.
DATABASE_URL=postgresql://admin:secret@127.0.0.1:5432/jobscheduler

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis connection string — distributed locks (Redlock) + API rate limiting.
# REQUIRED.
REDIS_URL=redis://127.0.0.1:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign JWT access tokens. REQUIRED — change in production!
JWT_SECRET=change-me-to-a-long-random-string
# Secret used to sign JWT refresh tokens. REQUIRED — use a DIFFERENT value
# from JWT_SECRET so leaking one token type doesn't compromise the other.
JWT_REFRESH_SECRET=change-me-too-another-random-string
# Access token lifetime (jsonwebtoken format). OPTIONAL — default: 15m.
JWT_ACCESS_TTL=15m
# Refresh token lifetime. OPTIONAL — default: 7d.
JWT_REFRESH_TTL=7d
# Shared secret between worker processes and the API for the worker-internal
# endpoints (POST /workers/register, POST /workers/:id/heartbeat).
# Sent by workers as the `x-worker-token` header. REQUIRED (a dev default
# "dev-worker-token" exists but must be changed outside local development).
WORKER_INTERNAL_TOKEN=change-me-worker-token

# ── API server ────────────────────────────────────────────────────────────────
# Port the Express API listens on. OPTIONAL — default: 4000.
API_PORT=4000
# Allowed CORS origin for the API and Socket.io ("*" is fine for dev).
# OPTIONAL — default: *.
CORS_ORIGIN=*
# Per-user API rate limit (requests/min, sliding window stored in Redis).
# OPTIONAL — default: 100.
API_RATE_LIMIT_PER_MIN=100
# Log verbosity for the API process: error | warn | info | debug.
# OPTIONAL — default: info.
LOG_LEVEL=info
# Service name attached to structured log lines. OPTIONAL — default: api.
SERVICE_NAME=api

# ── Scheduler intervals (API process background loops) ───────────────────────
# All OPTIONAL — sensible defaults shown.
# How often due cron schedules are fired.                       default: 60000 (60s)
CRON_RUNNER_INTERVAL_MS=60000
# How often SCHEDULED/RETRYING jobs past their runAt become PENDING. default: 15000 (15s)
DELAYED_PROMOTER_INTERVAL_MS=15000
# How often silent workers are marked DEAD and their jobs recovered. default: 30000 (30s)
DEAD_REAPER_INTERVAL_MS=30000
# How often unblocked-dependency WebSocket updates are pushed.  default: 10000 (10s)
DEPENDENCY_CHECKER_INTERVAL_MS=10000
# A worker whose last heartbeat is older than this is considered dead.
DEAD_WORKER_THRESHOLD_MS=60000

# ── Worker ────────────────────────────────────────────────────────────────────
# Base URL of the API the worker registers/heartbeats against.
# OPTIONAL — default: http://127.0.0.1:4000/api/v1.
API_BASE_URL=http://127.0.0.1:4000/api/v1
# Max jobs a single worker process executes in parallel. OPTIONAL — default: 5.
WORKER_CONCURRENCY=5
# Delay between polls when no jobs are available (ms, backoff). default: 2000.
WORKER_POLL_INTERVAL_MS=2000
# Heartbeat frequency (workers silent > DEAD_WORKER_THRESHOLD_MS get reaped).
# OPTIONAL — default: 10000.
WORKER_HEARTBEAT_INTERVAL_MS=10000
# Default execution timeout for jobs that don't set timeoutMs explicitly.
# OPTIONAL — default: 30000.
WORKER_DEFAULT_TIMEOUT_MS=30000
# Pin this worker process to a single queue id (empty = all eligible queues).
# OPTIONAL.
WORKER_QUEUE_ID=
# Shard this worker belongs to (e.g. us-east). It will claim queues with a
# matching shard_key plus unsharded queues; leave empty for an unsharded
# worker that only claims unsharded queues. OPTIONAL.
WORKER_SHARD_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Dev-server port for the Vite dashboard. OPTIONAL — default: 5173.
WEB_PORT=5173
# In production (docker compose / nginx) requests are proxied at /api and
# /socket.io, so no explicit API URL variable is needed by the web build.

# ── Optional — AI failure summaries via OpenRouter ────────────────────────────
# Enables automatic failure analysis on DLQ entries (stored as aiSummary).
# Get a free key at https://openrouter.ai/keys — free-tier models are supported.
# If omitted, everything else works normally; DLQ entries simply have no AI
# summary and the dashboard shows a hint instead.
OPENROUTER_API_KEY=
# Model used for summaries. Any OpenRouter chat model works; the default is
# free. OPTIONAL — default: meta-llama/llama-3.3-70b-instruct:free.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Override only if you proxy OpenRouter elsewhere. OPTIONAL.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Runtime ───────────────────────────────────────────────────────────────────
# development | production | test. Affects logging format and Prisma globals.
NODE_ENV=development

# ── Docker Compose only (used by docker-compose.yml, not by app code) ────────
# Credentials for the postgres container's initial database.
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
